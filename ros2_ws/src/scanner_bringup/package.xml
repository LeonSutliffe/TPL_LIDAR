<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scanner_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level bringup for the terrestrial LiDAR scanner: VLP-16 driver +
    pointcloud config, and a combined launch file for tilt axis, tf,
    velodyne, aggregation, VLP-16 hardware config, and optional rosbag2
    recording.
  </description>
  <maintainer email="leon.sutliffe@gmail.com">Leon Sutliffe</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>velodyne_driver</exec_depend>
  <exec_depend>velodyne_pointcloud</exec_depend>
  <exec_depend>tilt_axis_bridge</exec_depend>
  <exec_depend>scanner_description</exec_depend>
  <exec_depend>scan_aggregator</exec_depend>
  <exec_depend>vlp16_config</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
